# Copy to scripts/rig/local.env (gitignored) to override rig defaults.
# Same Windows+WSL host as ../rlx/rig.sh is typical.

# RIG_HOST=user@100.103.104.54
# SSH_KEY=$HOME/.ssh/utm_windows

# Runtime: windows | wsl | both  (or use --windows / --wsl / --both flags)
# RIG_RUNTIME=both

# Shared D: workspace (WSL sees /mnt/d/rlx-workspace/...)
# RIG_WORKSPACE_WIN=D:/rlx-workspace
# RIG_ROOT_WIN=D:/rlx-workspace/tribev2-rs
# RIG_BUILD_WIN=C:/Users/user/AppData/Local/rlx-workspace/tribev2-rs
# RIG_TARGET_WIN=C:/Users/user/AppData/Local/tribev2-cargo-target
# RIG_DATA_WIN=D:/rlx-workspace/tribev2-rs/data

# RIG_WSL_DISTRO=Ubuntu
# RIG_ROOT_WSL=/mnt/d/rlx-workspace/tribev2-rs
# RIG_WSL_TOOLCHAIN=stable

# Benchmark tag for bench/rig/<tag>_windows vs <tag>_wsl
# RIG_BENCH_TAG=20260529

# Local path when syncing weights from dev machine
# TRIBEV2_DATA_SRC=/path/to/tribev2-rs/data
